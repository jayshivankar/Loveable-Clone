# --- Core Platform ---
OPENAI_API_KEY=sk-...
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/codeforge
ENABLE_FIXER=true

# --- RAG configuration ---
# (Embedded PDFs in Agents/RAG/Data will be ingested into DATABASE_URL)

# --- S3 / R2 Storage ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=
AWS_ENDPOINT_URL=

# --- Logging ---
# Set to DEBUG for verbose logs, INFO for production
LOG_LEVEL=INFO
